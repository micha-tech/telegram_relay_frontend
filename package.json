    "test:production": "playwright test --config playwright.production.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests *.json *.config.ts README.md",
    "format:check": "prettier --check src tests *.json *.config.ts README.md"
  },
  "keywords": [],
