# Base URL of the Python Telethon backend, without a trailing slash.
# Leave empty to keep the Telegram Accounts feature in "not configured" mode:
# the page will explain that the integration is unavailable instead of
# returning fake data.
# This value is inlined into the client bundle at build time, so set it in
# your Vercel project environment variables before running `next build`.
NEXT_PUBLIC_TELEGRAM_API_BASE_URL=
