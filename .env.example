# Base URL of the Prime Edge backend, including the API version prefix and
# without a trailing slash. The backend exposes the API under `/api/v1/`.
# Example: https://telethon.example.com/api/v1
# Leave empty to keep the authentication and Telegram Accounts features in
# "not configured" mode: the pages explain that the integration is
# unavailable instead of returning fake data.
# This value is inlined into the client bundle at build time, so set it in
# your Vercel project environment variables before running `next build`.
NEXT_PUBLIC_TELEGRAM_API_BASE_URL=
